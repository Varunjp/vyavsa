# ==============================================================================
# Vyavsa Small Business Bill Book SaaS Configuration
# ==============================================================================

# Application Configuration
APP_NAME=vyavsa-bill-book-api
APP_ENV=development
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
POSTGRES_HOST_PORT=5433
DATABASE_NAME=billbook
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_AUTO_MIGRATE=true

# Optional full URL override:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/billbook?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=super-secret-development-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Structured Logging
LOG_LEVEL=info
LOG_FORMAT=text # "text" for local development, "json" for production

# Observability (Prometheus & Grafana)
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# CORS Policy (Comma-separated allowed origins or * for open)
CORS_ALLOWED_ORIGINS=*

# Password Recovery / Forgot Password Flow
PASSWORD_RESET_OTP_EXPIRY=5m
PASSWORD_RESET_TOKEN_EXPIRY=10m
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN=60s
PASSWORD_RESET_MAX_EMAIL_REQUESTS=3
PASSWORD_RESET_MAX_IP_REQUESTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW=15m

# Distributed Redis Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_AUTH_FAIL_OPEN=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60s
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=60s
RATE_LIMIT_SECURITY_REQUESTS=5
RATE_LIMIT_SECURITY_WINDOW=60s
RATE_LIMIT_TENANT_REQUESTS=300
RATE_LIMIT_TENANT_WINDOW=60s
RATE_LIMIT_PLATFORM_REQUESTS=300
RATE_LIMIT_PLATFORM_WINDOW=60s

# ==============================================================================
# Email Delivery Configuration
# Development: EMAIL_PROVIDER=smtp (uses Gmail SMTP) or log (for local testing)
# Production:  EMAIL_PROVIDER=resend (requires RESEND_API_KEY and verified domain)
# ==============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM="Vyavsa Support <no-reply@vyavsa.com>"
EMAIL_FROM_NAME="Vyavsa Support"

# Gmail SMTP Configuration (Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=no-reply@vyavsa.com
SMTP_FROM_NAME="Vyavsa Support"

# Resend Configuration (Production)
RESEND_API_KEY=re_your_api_key_here

# ==============================================================================
# Platform Administrator Bootstrap Credentials
# Automatically created / synchronized on startup from environment variables
# ==============================================================================
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=true
PLATFORM_ADMIN_EMAIL=admin@vyavsa.com
PLATFORM_ADMIN_PASSWORD=Admin@12345
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PHONE=+919876543210
